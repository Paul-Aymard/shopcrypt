# =====================================================================
# .gitignore — fichiers que Git ne doit JAMAIS envoyer sur GitHub
# =====================================================================

# Dépendances npm : très lourdes, et recréées par "npm install".
node_modules/

# SÉCURITÉ : fichiers de variables d'environnement.
# Ils contiennent DATABASE_URL (mot de passe de la base) et JWT_SECRET
# (la clé qui signe les jetons). S'ils fuitent sur GitHub, n'importe qui
# peut lire la base ou fabriquer de faux jetons de connexion.
.env
.env.local
.env.*.local

# Dossier créé par "vercel link" / "vercel dev" (identifiants du projet).
.vercel/

# SÉCURITÉ / CRYPTO : clés privées RSA téléchargées pendant les tests.
# Une clé privée ne doit JAMAIS être publiée : elle permet de déchiffrer
# tous les messages reçus par son propriétaire.
*.pem

# Fichiers système inutiles.
.DS_Store
Thumbs.db

.vercel
.env*
