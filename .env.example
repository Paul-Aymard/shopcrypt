# =====================================================================
# Modèle de variables d'environnement (CE fichier-ci peut aller sur Git :
# il ne contient AUCUNE vraie valeur).
#
# Pour travailler en local avec "vercel dev" :
#   copiez ce fichier en .env et remplissez-le à la main
#   (DATABASE_URL : console Neon > Connect ; JWT_SECRET : voir plus bas).
# Attention : "vercel dev" lit .env, PAS .env.local.
# .env est ignoré par Git (voir .gitignore).
# =====================================================================

# Adresse de connexion à la base Neon (ajoutée automatiquement par Vercel Storage).
DATABASE_URL=postgresql://utilisateur:motdepasse@hote.neon.tech/neondb?sslmode=require

# Secret qui signe les jetons JWT : une longue chaîne aléatoire (64 octets en hexadécimal).
# Pour en générer un : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=remplacez_moi_par_une_longue_chaine_aleatoire
